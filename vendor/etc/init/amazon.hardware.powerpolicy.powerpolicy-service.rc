# powerpolicy/amazon.hardware.powerpolicy.powerpolicy-service.rc
service powerpolicy /vendor/bin/hw/amazon.hardware.powerpolicy-service
        interface aidl amazon.hardware.powerpolicy.IAmazonPowerPolicyServer/default
        class hal
        user system
        group system
