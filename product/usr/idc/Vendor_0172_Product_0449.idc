# Celestine BLE HID Touchpad (Vendor 0172, Product 0449)
# Gesture properties tuned for BLE touchpad behavior

device.type = touchpad
gestureProp.Evaluation_Timeout = 0.050
gestureProp.Change_Timeout = 0.050
gestureProp.Trend_Classifying_Num_of_Samples = 12
gestureProp.Two_Finger_Scroll_Distance_Thresh = 1.000000
gestureProp.Two_Finger_Move_Distance_Thresh = 5.000000
gestureProp.Change_Min_Move_Distance = 2.000000
gestureProp.Fling_Buffer_Depth = 6
gestureProp.Fling_Stop_Extra_Delay = 0.030000
gestureProp.Motion_Tap_Prevent_Timeout = 0.020000
