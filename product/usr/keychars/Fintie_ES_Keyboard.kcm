    shift, capslock:                    'I'
    shift+capslock:                     'i'
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    shift+capslock:                     'o'
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    shift+capslock:                     'p'
}

key LEFT_BRACKET {
    label:                              '\u0300'
    base:                               '\u0300'
    shift:                              '\u0302'
    ralt:                               '['
}

key RIGHT_BRACKET {
    label:                              '+'
    base:                               '+'
    shift:                              '*'
    ralt:                               ']'
}

key BACKSLASH {
    label:                              '\u00e7'
    base:                               '\u00e7'
    shift, capslock:                    '\u00c7'
    shift+capslock:                     '\u00e7'
    ralt:                               '}'
}

