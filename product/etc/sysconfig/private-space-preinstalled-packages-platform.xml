<config>
    <!-- List of packages to be excluded from private space -->
    <!-- Amazon Shop -->
    <install-in-user-type package="com.amazon.windowshop">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!-- Amazon Alexa -->
    <install-in-user-type package="com.amazon.dee.app">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!-- Amazon Alexa Calendar -->
    <install-in-user-type package="com.amazon.alexa.calendar.app">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!-- Amazon Kids -->
    <install-in-user-type package="com.amazon.tahoe">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!-- Amazon Music - No Changes-->
    <install-in-user-type package="com.amazon.mp3">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!-- Audible -->
    <install-in-user-type package="com.audible.application.kindle">
        <install-in user-type="SYSTEM"/>
        <install-in user-type="FULL"/>
    </install-in-user-type>

