<permissions>
    <privapp-permissions package="com.amazon.diode">
        <!-- Required to access Build.getSerial() function to get the serial number of the device
             for Arcus config.  -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>

        <!-- Required for 1-click action for CSA or customer to remotely reboot a device to resolve
             health issues -->
        <permission name="android.permission.REBOOT"/>

        <!-- Required for 1-click action for CSA or customer to remotely change accessibility
             settings -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
