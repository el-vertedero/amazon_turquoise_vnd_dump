<permissions>
    <!-- Metrics service on device to extract data from Statsd-->
    <privapp-permissions package="com.amazon.metrics">
        <!-- Required to run a background service common across all profiles.-->
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <!-- Required to register and read configurations with statsd via statsdManager.-->
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <!-- Required to register and read configurations with statsd via statsdManager.-->
        <permission name="android.permission.DUMP"/>
    </privapp-permissions>
</permissions>
