<permissions>
    <privapp-permissions package="com.amazon.ods.kindleconnect">
        <!-- Required for 1-click action for CSA or customer to remotely reboot a device to resolve
             health issues -->
        <permission name="android.permission.REBOOT"/>

        <!-- Required to call Build.getSerial() for DSN. DSN is needed for business metrics and
             Spectator log uploads. -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>

        <!-- Required to start the MSS service from the background without restrictions -->
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>

        <!-- Required to get current foreground activity to auto-pause an MSS session -->
        <permission name="android.permission.REAL_GET_TASKS"/>

        <!-- Required to subscribe to device locked and keyguard locked states. -->
        <permission name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE" />
    </privapp-permissions>
</permissions>
