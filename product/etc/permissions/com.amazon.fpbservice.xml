<permissions>
    <privapp-permissions package="com.amazon.fpbservice">
        <!-- This is required for starting FG service from BroadcastRecievers -->
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" fixed="true"/>

        <!-- Bluetooth permission required for Stylus pairing and unpairing -->
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" fixed="true"/>

        <!-- This is required for write global settings -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS" fixed="true"/>

        <!-- Permission required for verifying that the service is running
            only in the foreground user via UserManager.isUserForeground -->
        <permission name="android.permission.INTERACT_ACROSS_USERS" fixed="true"/>

        <!-- Permission required for enabling/disabling stylus settings pages -->
        <permission name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" fixed="true"/>
    </privapp-permissions>
</permissions>