<permissions>
    <privapp-permissions package="com.amazon.networkmanager">
        <!-- Required to use DSN as a persistent salt crossing reboots to encrypt SSID
             that saved in local file. -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <!-- Required to use registerScanListener to receive the wifi scanResults to
             monitor the SSID changes. -->
        <permission name="android.permission.LOCATION_HARDWARE" />
        <!-- Required to send out broadcast intents to all users by calling
             sendBroadcastAsUser. -->
        <permission name="android.permission.INTERACT_ACROSS_USERS" />
    </privapp-permissions>
</permissions>