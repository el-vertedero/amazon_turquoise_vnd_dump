<permissions>
    <privapp-permissions package="com.amazon.device.software.ota">
        <!--
            OTA Client will be singleUser component in Streamline-14 and "android.permission.INTERACT_ACROSS_USERS_FULL" permission
            is not recommended in Streamline-14. To support singleUser functionality of OTA Client , a bound service will be created
            within OTA Client for the client to bind and the bound service will interact with the . For the interaction between
            the bound service and the OTA Client requires INTERACT_ACROSS_USERS android permission
        -->
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <!--
            This permission allows the app to free device storage by deleting files in the cache directories of other applications.
            If there isn't enough space in the app cache to get the requested space for the update, OTA Client clears the app cache
            and this permission is required to perform it.
        -->
        <permission name="android.permission.CLEAR_APP_CACHE"/>
        <!--
            As part of clearing cache or disk space for installation of updates, OTA Client queries the storage stats of a package
            since we don't want to unnecessarily clear cache if clearing cache will not help install the update.
            StorageStatsManager provides access to detailed storage statistics. This provides a summary of how apps, users,
            and external/shared storage is utilizing disk space. calling these APIs for any other package other than your own package
            requires this permission.
        -->
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <!--
            Permission allows an Android application to install updates to itself without requiring user intervention. This permission is
            typically used by apps that have a mechanism to update themselves automatically without going through any other external update mechanism.

            Currently, OTA Client is updated during OS update. In Future, If we want to send an App Update for OTA Client,
            this permission is required to update itself
        -->
        <permission name="android.permission.INSTALL_SELF_UPDATES"/>
        <!--
            This permission is required by OTA Client to install updates to other packages (i.e., other apps) on the device
        -->
        <permission name="android.permission.INSTALL_PACKAGE_UPDATES"/>
        <!--
            This permission provides OTA Client the ability to install packages (i.e., applications) on the device
        -->
        <permission name="android.permission.INSTALL_PACKAGES"/>
        <!--
            This permission allows the requesting app to access privileged information about the device's phone state.
            It is required to access Build.getSerial() function to get the DeviceSerialNumber of the device
        -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>

        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        
        <permission name="android.permission.ACCESS_CACHE_FILESYSTEM"/>
        <permission name="android.permission.DELETE_CACHE_FILES"/>
        <permission name="android.permission.DELETE_PACKAGES"/>
        <permission name="android.permission.RECOVERY"/>
        <permission name="android.permission.CRYPT_KEEPER"/>
        <permission name="android.permission.REBOOT"/>
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.ALLOCATE_AGGRESSIVE"/>
    </privapp-permissions>
</permissions>