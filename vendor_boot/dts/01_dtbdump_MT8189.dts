/dts-v1/;

/ {
	model = "MT8189";
	compatible = "mediatek,MT8189";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@11c20000";
		i2c1 = "/soc/i2c@11c21000";
		i2c2 = "/soc/i2c@11b20000";
		i2c3 = "/soc/i2c@11d70000";
		i2c4 = "/soc/i2c@11d71000";
		i2c5 = "/soc/i2c@11d72000";
		i2c6 = "/soc/i2c@11d73000";
		i2c7 = "/soc/i2c@11f30000";
		i2c8 = "/soc/i2c@11f31000";
		ovl0 = "/soc/disp-ovl0-4l@14002000";
		ovl1 = "/soc/disp-ovl1-4l@14003000";
		rdma0 = "/soc/disp-rdma0@14006000";
		rdma1 = "/soc/disp-rdma1@14007000";
		color0 = "/soc/disp-color0@14008000";
		color1 = "/soc/disp-color1@14009000";
		ccorr0 = "/soc/disp-ccorr0@1400a000";
		ccorr1 = "/soc/disp-ccorr1@1400b000";
		ccorr2 = "/soc/disp-ccorr2@1400c000";
		ccorr3 = "/soc/disp-ccorr3@1400d000";
		aal0 = "/soc/disp-aal0@1400e000";
		aal1 = "/soc/disp-aal1@1400f000";
		gamma0 = "/soc/disp-gamma0@14010000";
		gamma1 = "/soc/disp-gamma1@14011000";
		dither0 = "/soc/disp-dither0@14012000";
		dither1 = "/soc/disp-dither1@14013000";
		dsi0 = "/soc/dsi@14016000";
		mutex0 = "/soc/disp-mutex0@14001000";
		wdma0 = "/soc/disp-wdma0@1401a000";
		wdma1 = "/soc/disp-wdma1@1401b000";
		rsz0 = "/soc/disp-rsz0@14004000";
		rsz1 = "/soc/disp-rsz1@14005000";
		dsc0 = "/soc/disp-dsc-wrap0@14014000";
		pwm0 = "/soc/disp-pwm0@1100e000";
		pwm1 = "/soc/disp-pwm1@1100f000";
		mmc0 = "/soc/mmc@11230000";
		mmc1 = "/soc/mmc@11240000";
		mmc2 = "/soc/mmc@11250000";
	};

	clkbuf-ctrl {
		compatible = "mediatek,mt8189-clkbuf";
		pmic = <0x02>;
		phandle = <0x11e>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup \t\t\t    8250.nr_uarts=4\t\t\t    androidboot.hardware=mt8189 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    transparent_hugepage=never \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    gpt=1 \t\t\t    firmware_class.path=/vendor/firmware \t\t\t    stsrq_always_enable=1";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x74>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0d>;
		};

		cpu@4 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0e>;
		};

		cpu@5 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x03 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07>;
			capacity-dmips-mhz = <0x10b>;
			#cooling-cells = <0x02>;
			phandle = <0x0f>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x03 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x06 0x07>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x03 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x08 0x09 0x06 0x07>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			phandle = <0x11>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0a>;
				};

				core1 {
					cpu = <0x0b>;
				};

				core2 {
					cpu = <0x0c>;
				};

				core3 {
					cpu = <0x0d>;
				};

				core4 {
					cpu = <0x0e>;
				};

				core5 {
					cpu = <0x0f>;
				};

				doe {
					phandle = <0x11f>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				doe {
					phandle = <0x120>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x19>;
				exit-latency-us = <0x39>;
				min-residency-us = <0x1644>;
				phandle = <0x04>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x23>;
				exit-latency-us = <0x52>;
				min-residency-us = <0x762>;
				phandle = <0x08>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x39>;
				exit-latency-us = <0x86>;
				min-residency-us = <0x1644>;
				phandle = <0x121>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x90>;
				min-residency-us = <0x99c>;
				phandle = <0x122>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x35f>;
				exit-latency-us = <0x4d5>;
				min-residency-us = <0x1644>;
				phandle = <0x05>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x288>;
				exit-latency-us = <0x494>;
				min-residency-us = <0x11da>;
				phandle = <0x09>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x960>;
				exit-latency-us = <0x12c0>;
				min-residency-us = <0x8980>;
				phandle = <0x06>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x07>;
			};
		};
	};

	atf-logger {
		compatible = "mediatek,tfa_debug";
		phandle = <0x123>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	interrupt-controller@c000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04 0x00>;
		phandle = <0x01>;

		ppi-partitions {

			interrupt-partition-0 {
				affinity = <0x0a 0x0b 0x0c 0x0d 0x0e 0x0f>;
				phandle = <0x18>;
			};

			interrupt-partition-1 {
				affinity = <0x10 0x11>;
				phandle = <0x19>;
			};
		};
	};

	logstore {
		enabled = <0x01>;
		pmic-register = <0xa0e>;
		phandle = <0x124>;
	};

	dcm@c530000 {
		compatible = "mediatek,mt6878-dcm";
		reg = <0x00 0xc530000 0x00 0xc8a0 0x00 0x10001000 0x00 0xa40 0x00 0x10022000 0x00 0x40 0x00 0x11035000 0x00 0x30 0x00 0x1c017000 0x00 0xc0>;
		reg-names = "mcusys_par_wrap\0infracfg_ao\0infra_ao_bcrm\0peri_ao_bcrm\0vlp_ao_bcrm";
		phandle = <0x125>;
	};

	mcupm@c540000 {
		compatible = "mediatek,mcupm";
		reg = <0x00 0xc540000 0x00 0x22000 0x00 0xc56fb00 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fba0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fc40 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fce0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fd80 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fe20 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56fec0 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04 0x00 0xc56ff60 0x00 0xa0 0x00 0xc582004 0x00 0x04 0x00 0xc582018 0x00 0x04 0x00 0xc582000 0x00 0x04 0x00 0xc582010 0x00 0x04>;
		reg-names = "mcupm_base\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox0_send\0mbox0_recv\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox1_send\0mbox1_recv\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox2_send\0mbox2_recv\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox3_send\0mbox3_recv\0mbox4_base\0mbox4_set\0mbox4_clr\0mbox4_send\0mbox4_recv\0mbox5_base\0mbox5_set\0mbox5_clr\0mbox5_send\0mbox5_recv\0mbox6_base\0mbox6_set\0mbox6_clr\0mbox6_send\0mbox6_recv\0mbox7_base\0mbox7_set\0mbox7_clr\0mbox7_send\0mbox7_recv";
		interrupts = <0x00 0x18 0x04 0x00 0x00 0x19 0x04 0x00 0x00 0x1a 0x04 0x00 0x00 0x1b 0x04 0x00 0x00 0x1c 0x04 0x00 0x00 0x1d 0x04 0x00 0x00 0x1e 0x04 0x00 0x00 0x1f 0x04 0x00>;
		interrupt-names = "mbox0\0mbox1\0mbox2\0mbox3\0mbox4\0mbox5\0mbox6\0mbox7";
		phandle = <0x126>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};

	odm {
		compatible = "simple-bus";
		phandle = <0x127>;
	};

	uarthub {
		compatible = "mediatek,mt6878-uarthub";
		uarthub-disable = <0x01>;
		phandle = <0x128>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x129>;

		adsp-mem-region@50000000 {
			compatible = "mediatek,adsp-reserved-memory";
			no-map;
			reg = <0x00 0x50000000 0x00 0x1800000>;
			phandle = <0x65>;
		};

		svp-memory {
			compatible = "mediatek,svp-memory";
			size = <0x00 0x19400000>;
			alloc-ranges = <0x01 0x00 0x01 0x40000000>;
			no-map;
			phandle = <0xdb>;
		};

		svp-wfd-memory {
			compatible = "mediatek,svp-wfd-memory";
			size = <0x00 0x4c00000>;
			alloc-ranges = <0x01 0x00 0x01 0x40000000>;
			no-map;
			phandle = <0xdc>;
		};
	};

	qos@103700 {
		compatible = "mediatek,mt6893-qos";
		reg = <0x00 0x103700 0x00 0x100 0x00 0x103800 0x00 0x140>;
		reg-names = "sram\0share_sram";
		mediatek,enable = <0x01>;
		phandle = <0x12a>;
	};

	cm-mgr@c531000 {
		compatible = "mediatek,mt8189-cm_mgr";
		reg = <0x00 0xc531000 0x00 0x8000>;
		reg-names = "cm_mgr_base";
		interconnects = <0x12 0x03 0x12 0x00>;
		interconnect-names = "cm-perf-bw";
		required-opps = <0x13 0x14 0x15 0x16 0x17>;
		cm-mgr-enable = <0x01>;
		cm-mgr-arch = "v1p";
		cm-mgr-num-array = <0x07>;
		cm-mgr,cp-down = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,cp-up = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,dt-down = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		cm-mgr,dt-up = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		cm-mgr,vp-down = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		cm-mgr,vp-up = <0x64 0x64 0x64 0x64 0x64 0x64 0x64>;
		use-cpu-to-dram-map = "enable";
		use-cpu-to-dram-map-new = "enable";
		cm-mgr-cpu-opp-to-dram = <0x01 0x01 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08 0x08>;
		cm-perf-mode-enable = <0x01>;
		cm-perf-mode-ceiling-opp = <0x00>;
		cm-perf-mode-thd = <0x05>;
		phandle = <0x12b>;
	};

	fpsgo {
		compatible = "mediatek,fpsgo";
		interconnects = <0x12 0x01 0x12 0x00>;
		interconnect-names = "fpsgo-perf-bw";
		required-opps = <0x13>;
		cpu-limit = <0x02>;
		gcc-enable = <0x01>;
		fbt-cpu-mask = <0xff 0xf0 0x0f 0x0f 0xf0 0xf0>;
		sbe-resceue-enable = <0x01>;
		phandle = <0x12c>;
	};

	syscon@d01a000 {
		compatible = "mediatek,mt8189-dbg_ao\0syscon";
		reg = <0x00 0xd01a000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x37>;
	};

	syscon@d0a0000 {
		compatible = "mediatek,mt8189-dem\0syscon";
		reg = <0x00 0xd0a0000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x38>;
	};

	efuse@11f10000 {
		compatible = "mediatek,devinfo";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x6c>;

		segment@78 {
			reg = <0x78 0x04>;
			phandle = <0x12d>;
		};

		u2-phy-data@334 {
			reg = <0x334 0x04>;
			phandle = <0x12e>;
		};

		cpu-data@234 {
			reg = <0x234 0x04>;
			phandle = <0x12f>;
		};

		lkg@218 {
			reg = <0x218 0x18>;
			phandle = <0x130>;
		};

		csi-data0@320 {
			reg = <0x320 0x04>;
			phandle = <0x131>;
		};

		csi-data1@324 {
			reg = <0x324 0x04>;
			phandle = <0x132>;
		};

		csi-data2@328 {
			reg = <0x328 0x04>;
			phandle = <0x133>;
		};

		csi-data3@32c {
			reg = <0x32c 0x04>;
			phandle = <0x134>;
		};

		isp-data0@14 {
			reg = <0x14 0x04>;
			phandle = <0x9d>;
		};

		gpu-efuse0@1c {
			reg = <0x1c 0x04>;
			phandle = <0x7b>;
		};

		gpu-efuse0@344 {
			reg = <0x344 0x04>;
			phandle = <0x7c>;
		};

		gpu-efuse0@348 {
			reg = <0x348 0x04>;
			phandle = <0x7d>;
		};

		gpu-efuse0@34c {
			reg = <0x34c 0x04>;
			phandle = <0x7e>;
		};

		data1@1b4 {
			reg = <0x1b4 0x54>;
			phandle = <0x68>;
		};

		data2@e4 {
			reg = <0xe4 0x08>;
			phandle = <0x69>;
		};
	};

	memory-ffa-enabled {
		compatible = "mediatek,memory-ffa-enabled";
		phandle = <0x135>;
	};

	page-based-v2-enabled {
		compatible = "mediatek,page-based-v2-enabled";
		phandle = <0x136>;
	};

	tee-mmap-by-page-enabled {
		compatible = "mediatek,tee-mmap-by-page-enabled";
		phandle = <0x137>;
	};

	lastbus {
		compatible = "mediatek,lastbus";
		enabled = <0x01>;
		sw-version = <0x01>;
		timeout-ms = <0xc8>;
		timeout-type = <0x00>;
		timeout-warning = <0x00>;
		phandle = <0x138>;

		monitors {

			monitor1 {
				monitor-name = "debug_ctrl_ao_INFRA_AO";
				base = <0x10023000>;
				num-ports = <0x36>;
				idle-masks = <0x0c 0x40000>;
				bus-status-offset = <0x1c>;
				bus-status-num = <0x07>;
				bus-freq-mhz = <0x4e>;
			};

			monitor2 {
				monitor-name = "debug_ctrl_ao_INFRA_AO1";
				base = <0x1002b000>;
				num-ports = <0x11>;
				bus-status-offset = <0x08>;
				bus-status-num = <0x02>;
				bus-freq-mhz = <0x4e>;
			};

			monitor3 {
				monitor-name = "debug_ctrl_ao_EMI_AO";
				base = <0x10042000>;
				num-ports = <0x0e>;
				bus-status-offset = <0x10>;
				bus-status-num = <0x04>;
				bus-freq-mhz = <0x2d8>;
			};

			monitor4 {
				monitor-name = "debug_ctrl_ao_PERI_PAR_AO";
				base = <0x11037000>;
				num-ports = <0x13>;
				bus-status-offset = <0x0c>;
				bus-status-num = <0x03>;
				bus-freq-mhz = <0x4e>;
			};

			monitor5 {
				monitor-name = "debug_ctrl_ao_VLP_AO";
				base = <0x1c01d000>;
				num-ports = <0x0c>;
				bus-status-offset = <0x0c>;
				bus-status-num = <0x03>;
