	firmware {
		phandle = <0x251>;

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x10c 0x00 0x10c 0x01>;
			shmem = <0x10d 0x10e>;
			mbox-names = "tx\0rx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x252>;

